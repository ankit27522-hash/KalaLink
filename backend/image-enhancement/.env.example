# Copy this file to `.env` in the same folder and adjust as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Must match the URL the React dev server / production build is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Upload limits ---
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Enhancement engine ---
# auto        -> try Real-ESRGAN, silently fall back to the classical
#                OpenCV pipeline if the model/weights/deps aren't available
# realesrgan  -> require Real-ESRGAN, error if unavailable
# classical   -> always use the dependency-light OpenCV pipeline
DEFAULT_ENHANCEMENT_BACKEND=auto

# Path to Real-ESRGAN weights (RealESRGAN_x4plus.pth). Only needed if you
# want the AI backend instead of the classical fallback. Download from:
# https://github.com/xinntao/Real-ESRGAN/releases
MODEL_PATH=models/RealESRGAN_x4plus.pth
