# Copy this file to `.env` in the same folder and fill in your own key.
# NEVER commit the real .env file.

# --- Groq API ---
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Server ---
PORT=5001

# --- CORS ---
# Must match the URL the React dev server / production build is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Upload limits ---
MAX_UPLOAD_MB=10
