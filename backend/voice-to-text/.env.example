# Copy this file to `.env` in the same folder and adjust as needed.

# --- Server ---
HOST=0.0.0.0
PORT=5000
RELOAD=true

# --- CORS ---
# Must match the URL the React dev server / production build is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Upload limits ---
MAX_UPLOAD_MB=15
ALLOWED_AUDIO_TYPES=audio/webm,audio/wav,audio/wave,audio/x-wav,audio/mpeg,audio/mp4,audio/ogg

# --- Whisper model ---
# Size tradeoff: tiny < base < small < medium < large-v3 (accuracy vs speed).
WHISPER_MODEL_SIZE=medium
# "cpu" or "cuda" (if you have an NVIDIA GPU + CUDA installed)
WHISPER_DEVICE=cpu
# "int8" is a big CPU speedup with minimal accuracy loss; use "float16" on GPU
WHISPER_COMPUTE_TYPE=int8

# No API keys required - faster-whisper runs the model locally.
